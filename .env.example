# Copy this file to a new file named .env and fill in your own values.
# NEVER commit your real .env file or share your bot token.

DISCORD_TOKEN=put_your_bot_token_here
GUILD_ID=put_your_server_id_here

# Optional: only if you have approved Reddit API access
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=job-radar/0.1 by u/your_username
